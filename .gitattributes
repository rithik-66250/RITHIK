<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BE FIT | Your Digital Gym Partner</title>
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">
    <!-- FontAwesome for Trendy Minimal Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        /* === BLACK & WHITE THEME VARIABLES === */
        :root {
            --bg-main: #f8f8f8;
            --bg-card: #ffffff;
            --text-main: #000000;
            --text-muted: #666666;
            --border-color: #e0e0e0;
            --black: #000000;
            --white: #ffffff;
            --shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
            --transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
            --font-family: 'Inter', sans-serif;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: var(--font-family); }

        body {
            background-color: var(--bg-main);
            color: var(--text-main);
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden; /* App-like layout */
        }

        /* === TOP NAVIGATION === */
        header {
            background-color: var(--bg-card);
            padding: 15px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border-color);
            z-index: 10;
        }

        .logo {
            font-size: 24px;
            font-weight: 800;
            letter-spacing: -1px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .search-wrapper {
            flex-grow: 1;
            max-width: 500px;
            margin: 0 30px;
            position: relative;
        }

        .search-wrapper input {
            width: 100%;
            padding: 12px 20px 12px 45px;
            border: 2px solid var(--black);
            border-radius: 30px;
            font-size: 15px;
            outline: none;
            transition: var(--transition);
        }

        .search-wrapper input:focus {
            background-color: var(--black);
            color: var(--white);
        }
        
        .search-wrapper input:focus::placeholder { color: #aaa; }

        .search-wrapper i {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            transition: var(--transition);
        }
        
        .search-wrapper input:focus + i { color: var(--white); }

        /* === LAYOUT === */
        .app-container {
            display: flex;
            flex: 1;
            overflow: hidden;
        }

        /* === SIDEBAR === */
        .sidebar {
            width: 260px;
            background-color: var(--bg-card);
            border-right: 1px solid var(--border-color);
            padding: 30px 20px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 14px 20px;
            border-radius: 12px;
            cursor: pointer;
            font-weight: 600;
            color: var(--text-muted);
            transition: var(--transition);
        }

        .nav-item:hover {
            background-color: #f0f0f0;
            color: var(--black);
        }

        .nav-item.active {
            background-color: var(--black);
            color: var(--white);
        }

        .nav-item i { font-size: 18px; width: 20px; text-align: center; }

        /* === MAIN CONTENT === */
        .main-content {
            flex: 1;
            padding: 40px;
            overflow-y: auto;
            background-color: var(--bg-main);
        }

        .view-section { display: none; animation: fadeIn 0.4s ease-out; }
        .view-section.active { display: block; }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        h1.page-title {
            font-size: 32px;
            font-weight: 800;
            margin-bottom: 5px;
            letter-spacing: -1px;
        }

        p.page-subtitle {
            color: var(--text-muted);
            margin-bottom: 30px;
            font-size: 16px;
        }

        /* === DASHBOARD STATS === */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }

        .stat-card {
            background: var(--bg-card);
            padding: 25px;
            border-radius: 16px;
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow);
            display: flex;
            flex-direction: column;
            gap: 10px;
            transition: var(--transition);
        }

        .stat-card:hover { transform: translateY(-5px); border-color: var(--black); }

        .stat-label {
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-muted);
            font-weight: 600;
        }

        .stat-value {
            font-size: 36px;
            font-weight: 800;
        }

        .trend-up { color: var(--black); font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 5px; }

        /* === BUTTONS === */
        .btn-primary {
            background: var(--black);
            color: var(--white);
            border: 2px solid var(--black);
            padding: 12px 24px;
            border-radius: 30px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-primary:hover { background: transparent; color: var(--black); }

        .btn-outline {
            background: transparent;
            color: var(--black);
            border: 2px solid var(--border-color);
            padding: 12px 24px;
            border-radius: 30px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
        }

        .btn-outline:hover { border-color: var(--black); }

        /* === GRID LISTS (Library & Plans) === */
        .grid-layout {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 25px;
        }

        .workout-card, .plan-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 25px;
            box-shadow: var(--shadow);
            display: flex;
            flex-direction: column;
            gap: 15px;
            transition: var(--transition);
        }

        .workout-card:hover { border-color: var(--black); transform: translateY(-3px); }
        
        .cat-tag {
            display: inline-block;
            background: #f0f0f0;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            align-self: flex-start;
        }

        .video-placeholder {
            width: 100%;
            height: 160px;
            background: #111;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--white);
            font-size: 40px;
            position: relative;
            overflow: hidden;
        }
        
        .video-placeholder::after {
            content: 'VIDEO DEMO';
            position: absolute;
            bottom: 10px; right: 10px;
            font-size: 10px; letter-spacing: 2px;
            background: rgba(0,0,0,0.5); padding: 4px 8px; border-radius: 4px;
        }

        .workout-details p { font-size: 13px; color: var(--text-muted); margin-bottom: 5px; }
        .workout-details strong { color: var(--black); }

        /* === TABLES === */
        .table-container {
            background: var(--bg-card);
            border-radius: 16px;
            border: 1px solid var(--border-color);
            overflow: hidden;
            box-shadow: var(--shadow);
        }

        table { width: 100%; border-collapse: collapse; }
        th, td { padding: 18px 20px; text-align: left; border-bottom: 1px solid var(--border-color); }
        th { background: #fafafa; font-size: 13px; text-transform: uppercase; color: var(--text-muted); letter-spacing: 1px; }
        tr:last-child td { border-bottom: none; }
        td { font-size: 15px; font-weight: 500; }
        .del-btn { color: #ff3333; background: none; border: none; cursor: pointer; padding: 5px; }

        /* === MODALS === */
        .modal-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.6); backdrop-filter: blur(4px);
            display: none; justify-content: center; align-items: center; z-index: 100;
        }
        
        .modal-content {
            background: var(--bg-card);
            width: 90%; max-width: 500px;
            border-radius: 20px; padding: 30px;
            position: relative; border: 2px solid var(--black);
            max-height: 90vh; overflow-y: auto;
        }

        .close-modal {
            position: absolute; top: 20px; right: 20px;
            background: none; border: none; font-size: 20px; cursor: pointer;
        }

        .form-group { margin-bottom: 18px; }
        .form-group label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 8px; text-transform: uppercase; }
        .form-group input, .form-group select {
            width: 100%; padding: 12px; border: 1px solid var(--border-color);
            border-radius: 8px; font-size: 15px; outline: none; transition: var(--transition);
        }
        .form-group input:focus { border-color: var(--black); box-shadow: 0 0 0 3px rgba(0,0,0,0.05); }

        .checkbox-list {
            max-height: 200px; overflow-y: auto; border: 1px solid var(--border-color);
            border-radius: 8px; padding: 10px;
        }
        .checkbox-item { display: flex; align-items: center; gap: 10px; padding: 8px 0; font-size: 14px; border-bottom: 1px solid #f0f0f0; }

        /* Responsive */
        @media(max-width: 768px) {
            header { padding: 15px 20px; flex-wrap: wrap; gap: 15px; }
            .search-wrapper { order: 3; margin: 0; max-width: 100%; }
            .app-container { flex-direction: column; }
            .sidebar { width: 100%; flex-direction: row; padding: 15px; overflow-x: auto; border-right: none; border-bottom: 1px solid var(--border-color); }
            .nav-item { padding: 10px 15px; white-space: nowrap; }
            .main-content { padding: 20px; }
        }
    </style>
</head>
<body>

    <!-- HEADER -->
    <header>
        <div class="logo">
            <i class="fa-solid fa-dumbbell"></i> BE FIT.
        </div>
        <div class="search-wrapper">
            <input type="text" id="searchInput" placeholder="Search workouts (e.g., Squat, Chest)..." onkeyup="handleSearch()">
            <i class="fa-solid fa-search"></i>
        </div>
        <div class="profile">
            <i class="fa-solid fa-circle-user" style="font-size: 28px; cursor:pointer;"></i>
        </div>
    </header>

    <div class="app-container">
        <!-- SIDEBAR -->
        <div class="sidebar">
            <div class="nav-item active" onclick="navigate('dashboard', this)">
                <i class="fa-solid fa-chart-pie"></i> Dashboard
            </div>
            <div class="nav-item" onclick="navigate('library', this)">
                <i class="fa-solid fa-play-circle"></i> Workout Library
            </div>
            <div class="nav-item" onclick="navigate('plans', this)">
                <i class="fa-solid fa-clipboard-list"></i> My Plans
            </div>
            <div class="nav-item" onclick="navigate('progress', this)">
                <i class="fa-solid fa-clock-rotate-left"></i> History & Logs
            </div>
        </div>

        <!-- MAIN CONTENT -->
        <div class="main-content">
            
            <!-- DASHBOARD VIEW -->
            <div id="view-dashboard" class="view-section active">
                <h1 class="page-title">Hey, Let's Get It! <i class="fa-solid fa-bolt" style="font-size:24px;"></i></h1>
                <p class="page-subtitle">Your gym partner is tracking every rep. Here is your progress.</p>
                
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-label">Reps This Month</div>
                        <div class="stat-value" id="statRepsThisMonth">0</div>
                        <div class="trend-up"><i class="fa-solid fa-arrow-trend-up"></i> Total effort</div>
                    </div>
                    <div class="stat-card" style="background: var(--black); color: var(--white);">
                        <div class="stat-label" style="color:#aaa;">Reps Last Month</div>
                        <div class="stat-value" id="statRepsLastMonth">0</div>
                        <div class="trend-up" style="color:#ddd;">Past benchmark</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-label">Total Volume (kg)</div>
                        <div class="stat-value" id="statVolume">0</div>
                        <div class="trend-up"><i class="fa-solid fa-weight-hanging"></i> Weight moved</div>
                    </div>
                </div>

                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px;">
                    <h3>Recent Logs</h3>
                    <button class="btn-outline" style="padding: 6px 15px; font-size:12px;" onclick="navigate('progress', document.querySelectorAll('.nav-item')[3])">View All</button>
                </div>
                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Exercise</th>
                                <th>Sets x Reps</th>
                                <th>Weight (kg)</th>
                            </tr>
                        </thead>
                        <tbody id="recentLogsTable"></tbody>
                    </table>
                </div>
            </div>

            <!-- LIBRARY VIEW -->
            <div id="view-library" class="view-section">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 5px;">
                    <h1 class="page-title">Workout Library</h1>
                    <button class="btn-primary" onclick="openPlanModal()"><i class="fa-solid fa-plus"></i> Add Plan</button>
                </div>
                <p class="page-subtitle">Master your form and log your reps directly.</p>
                
                <!-- Filter tags -->
                <div style="display:flex; gap:10px; flex-wrap:wrap; margin-bottom: 25px;" id="categoryFilters">
                    <!-- Populated by JS -->
                </div>

                <div class="grid-layout" id="libraryGrid">
                    <!-- Cards populated by JS -->
                </div>
            </div>

            <!-- PLANS VIEW -->
            <div id="view-plans" class="view-section">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 5px;">
                    <h1 class="page-title">My Plans</h1>
                    <button class="btn-primary" onclick="openPlanModal()"><i class="fa-solid fa-plus"></i> New Plan</button>
                </div>
                <p class="page-subtitle">Build and edit routines for progressive overload.</p>
                
                <div class="grid-layout" id="plansGrid">
                    <!-- Plans populated by JS -->
                </div>
            </div>

            <!-- PROGRESS VIEW -->
            <div id="view-progress" class="view-section">
                <h1 class="page-title">History & Logs</h1>
                <p class="page-subtitle">Track your progressive weight increase over time.</p>
                
                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Exercise</th>
                                <th>Sets</th>
                                <th>Reps</th>
                                <th>Weight (kg)</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody id="fullHistoryTable"></tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>

    <!-- MODAL: LOG WORKOUT -->
    <div class="modal-overlay" id="logModal">
        <div class="modal-content">
            <button class="close-modal" onclick="closeModals()"><i class="fa-solid fa-xmark"></i></button>
            <h2 style="margin-bottom: 5px; font-weight:800;" id="logTitle">Log Workout</h2>
            <p style="color:var(--text-muted); font-size:13px; margin-bottom: 20px;" id="logDesc"></p>
            
            <input type="hidden" id="logExerciseId">
            <input type="hidden" id="logExerciseName">
            
            <div class="form-group">
                <label>Date</label>
                <input type="date" id="logDate" required>
            </div>
            
            <div style="display:flex; gap:15px;">
                <div class="form-group" style="flex:1;">
                    <label>Sets</label>
                    <input type="number" id="logSets" placeholder="e.g. 3" min="1" required>
                </div>
                <div class="form-group" style="flex:1;">
                    <label>Reps (per set)</label>
                    <input type="number" id="logReps" placeholder="e.g. 10" min="1" required>
                </div>
            </div>
            
            <div class="form-group">
                <label>Weight (kg)</label>
                <input type="number" id="logWeight" placeholder="e.g. 60" min="0" required>
            </div>

            <div class="form-group">
                <label>Notes / Personal Record (Optional)</label>
                <input type="text" id="logNotes" placeholder="e.g. Felt easy, form was good">
            </div>
            
            <button class="btn-primary" style="width:100%; justify-content:center;" onclick="saveLog()">Save to Tracker</button>
        </div>
    </div>

    <!-- MODAL: MANAGE PLAN -->
    <div class="modal-overlay" id="planModal">
        <div class="modal-content">
            <button class="close-modal" onclick="closeModals()"><i class="fa-solid fa-xmark"></i></button>
            <h2 style="margin-bottom: 20px; font-weight:800;" id="planModalTitle">Create Plan</h2>
            
            <input type="hidden" id="planId">
            
            <div class="form-group">
                <label>Plan Name</label>
                <input type="text" id="planName" placeholder="e.g. Push Day, Full Body" required>
            </div>
            
            <div class="form-group">
                <label>Select Exercises</label>
                <div class="checkbox-list" id="planExercisesList">
                    <!-- Populated by JS -->
                </div>
            </div>
            
            <button class="btn-primary" style="width:100%; justify-content:center;" onclick="savePlan()">Save Plan</button>
        </div>
    </div>

